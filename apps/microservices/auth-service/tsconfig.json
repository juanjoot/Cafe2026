{
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "moduleResolution": "node",
    "incremental": true,
    "strict": true,
    "esModuleInterop": true,
    "rootDirs": ["./src", "../../../packages/shared"],
    "paths": {
      "@shared/*": ["../../../packages/shared/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}